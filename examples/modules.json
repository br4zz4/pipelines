{
  "region": "us-west1",
  "shared": [".github/", "tasks/", ".project/", "Makefile", "compose.yml"],
  "modules": {
    "main": {
      "code": {
        "dir": "modules/main/code",
        "package": {
          "context": "modules/main/code",
          "target": "web"
        }
      },
      "infra": {
        "dir": "modules/main/deploy/terraform/gcp/envs/{env}",
        "check_dir": "modules/main/deploy/terraform",
        "state": {
          "bucket": "has-warranty-tfstate-{env}",
          "prefix": "has-warranty/terraform.tfstate"
        },
        "vars": {
          "web_image_tag": "{tag}"
        }
      },
      "environments": {
        "staging": {
          "project": "has-warranty-staging",
          "repository": "has-warranty-staging",
          "prefix": "has-warranty-staging",
          "url": "https://staging.tenhoessanota.com.br"
        },
        "production": {
          "project": "has-warranty-production",
          "repository": "has-warranty-production",
          "prefix": "has-warranty-production",
          "url": "https://tenhoessanota.com.br",
          "source": "staging"
        }
      }
    },
    "checkout": {
      "code": {
        "dir": "modules/checkout/code",
        "package": {
          "context": "modules/checkout/code",
          "target": "web"
        }
      },
      "infra": {
        "dir": "modules/checkout/deploy/terraform/gcp/envs/{env}",
        "check_dir": "modules/checkout/deploy/terraform",
        "state": {
          "bucket": "has-warranty-tfstate-{env}",
          "prefix": "checkout/terraform.tfstate"
        },
        "vars": {
          "web_image_tag": "{tag}",
          "migrate_image_tag": "{tag}"
        }
      },
      "environments": {
        "staging": {
          "project": "has-warranty-staging",
          "repository": "checkout-staging",
          "prefix": "checkout-staging",
          "url": "https://checkout.staging.tenhoessanota.com.br"
        },
        "production": {
          "project": "has-warranty-production",
          "repository": "checkout-production",
          "prefix": "checkout-production",
          "url": "https://checkout.tenhoessanota.com.br",
          "source": "staging"
        }
      }
    }
  }
}
